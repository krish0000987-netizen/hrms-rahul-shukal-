# ========================================
# Rahul HRMS Environment Configuration
# ========================================

# Set "DEBUG=False" for production deployments
DEBUG=False

# Django Secret Key (generate a secure key for production)
SECRET_KEY=your-django-production-secret-key-here

# Allowed Hosts (comma-separated domains)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8000

# Timezone & Regional Settings
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Application Branding
APP_NAME="Rahul HRMS"
APP_SUBTITLE="Human Resource Management System"
DOC_BASE_URL="#"

# ========================================
# Supabase PostgreSQL Database Configuration
# ========================================
# Option 1: Direct or Pooler Database URL
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require

# Option 2: Structured Supabase DB variables
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.[PROJECT_REF]
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ========================================
# Supabase API & Storage Configuration
# ========================================
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=rahul-hrms
USE_SUPABASE_STORAGE=True

# Database initialization password
DB_INIT_PASSWORD=your-secure-initialization-password-48-chars

# ========================================
# Redis Cache & Background Tasks (Optional)
# ========================================
# REDIS_URL=redis://127.0.0.1:6379/1

# ========================================
# Email (SMTP) Configuration
# ========================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=notifications@yourdomain.com
# EMAIL_HOST_PASSWORD=your-email-app-password
# DEFAULT_FROM_EMAIL=Rahul HRMS <notifications@yourdomain.com>

# ========================================
# Third-party Integrations (Optional)
# ========================================
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback/
